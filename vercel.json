{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "review-server": {
      "root": "backend/crates/review-server",
      "runtime": "rust"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "review-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
