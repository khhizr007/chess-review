{
  "manifest_version": 3,
  "name": "KnightReview: Free Chess Game Review",
  "short_name": "KnightReview",
  "version": "1.0.1",
  "description": "Free reviews of your Chess.com games: click Review and the game opens in KnightReview. Not affiliated with Chess.com.",
  "homepage_url": "https://knightreview.online/",
  "minimum_chrome_version": "118",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "KnightReview settings",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "permissions": ["declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": ["https://*.chess.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://*.chess.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{ "resources": ["redirect.html"], "matches": ["https://*.chess.com/*"] }],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
